---
/**
 * Banda azul a todo el ancho (Figma "Group 1000007222", node 169:98): degradado
 * azul con el patrón de ondas tenue. Envuelve SplitSections con tone="dark".
 */
import { url } from '../../data/sitio';
const fondo = `url('${url('/img/otitis/banda-ondas.svg')}')`;
---
<div class="banda" style={`--fondo:${fondo}`}>
  <slot />
</div>

<style>
  .banda {
    display: grid;
    gap: clamp(48px, 4.3vw, 83px);
    padding-block: clamp(48px, 4vw, 77px);
    background: var(--azul-900) var(--fondo) center / 100% 100% no-repeat;
    color: #fff;
  }
</style>
