---
// Tienda 3D: se recorre caminando entre góndolas, en tercera o primera persona, y se compra con
// el mismo carrito de WooCommerce que las tarjetas (Store API + Cart-Token). Para pagar se usa el
// checkout de siempre (/tarjetas/#carrito), así que el pedido entra igual a WooCommerce.
//   Computadora: WASD / flechas para caminar, mouse para mirar, clic o E para ver un producto,
//                C cambia la cámara, Shift corre, rueda = zoom (tercera persona).
//   Celular:     joystick a la izquierda, arrastrar para mirar, tocar un producto para verlo.
//   VR (WebXR):  gatillo sobre un producto lo agrega; gatillo sobre el piso = teletransporte;
//                stick izquierdo camina, stick derecho gira de a 30°.
// Three.js se descarga recién al entrar (la página abre al instante).
import { getImage } from 'astro:assets';
import Logo from '../Logo.astro';
import { rutas, marca, url } from '../../data/sitio';
import type { Producto } from '../../data/tienda';
import { storeApiUrl, tiendaUrl } from '../../data/tienda';
import { getExhibiciones, getExhibicionesProducto, getDestacados, getPasillos, getMusica } from '../../data/ajustes';

interface Props {
  productos: Producto[];
}
const { productos } = Astro.props;

// Fotos copiadas al propio sitio y achicadas (384 px): las texturas de WebGL necesitan el mismo
// dominio (o CORS) y así pesan poco.
// Cómo se exhibe cada categoría (WordPress → Productos → Categorías) y los productos destacados.
const exhibiciones = await getExhibiciones();
const destacados = new Set(await getDestacados());
const exhibicionesProducto = await getExhibicionesProducto();
const exhibicionDe = (p: Producto) => exhibicionesProducto[String(p.id)] ?? p.categorias.map((c) => exhibiciones[c.slug]).find(Boolean) ?? 'gondola';
const pasillos = await getPasillos();
const musica = await getMusica();
const datos = await Promise.all(
  productos.map(async (p) => {
    let img = '';
    if (p.imagen) {
      try {
        img = (await getImage({ src: p.imagen.src, inferSize: true, width: 384, format: 'webp' })).src;
      } catch {
        img = '';
      }
    }
    return {
      id: p.id,
      sku: p.sku,
      nombre: p.nombre,
      precio: p.precio,
      precioAnterior: p.precioAnterior,
      descuento: p.descuento,
      stock: p.stockTexto,
      enStock: p.enStock,
      resumen: p.resumen,
      img,
      categoria: p.categorias[0]?.nombre ?? '',
      exhibicion: exhibicionDe(p),
      destacado: destacados.has(p.id),
    };
  }),
);
---
<main
  class="t3d"
  data-api={storeApiUrl}
  data-productos={JSON.stringify(datos)}
  data-pasillos={JSON.stringify(pasillos)}
  data-presencia={`${tiendaUrl}/wp-json/tindershop/v1/presencia`}
  data-pagar={`${rutas.tarjetas}#carrito`}
  data-modelos={url('/modelos/')}
  data-musica={JSON.stringify(musica)}
>
  <h1 class="sr-only">{marca.nombre}: tienda 3D</h1>
  <div class="lienzo" data-lienzo></div>
  <div class="zona-mirar" data-zona-mirar hidden></div>

  <header class="barra">
    <Logo size={150} />
    <p class="gente" data-gente hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" /><circle cx="17" cy="9" r="2.6" /><path d="M15.5 14.2A4.6 4.6 0 0 1 21 19" /></svg>
      <span data-gente-n></span>
    </p>
    <div class="barra-botones">
      <a class="btn-redondo" href={rutas.tarjetas} title="Comprar con tarjetas deslizables">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="11" height="15" rx="2" /><path d="M9 3h9a2 2 0 0 1 2 2v13" /></svg>
        <span class="sr-only">Comprar con tarjetas</span>
      </a>
      <button class="btn-redondo" type="button" data-musica-boton title="Música" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /></svg>
        <span class="tachado" data-musica-tachado hidden></span>
        <span class="sr-only">Silenciar o activar la música</span>
      </button>
      <button class="btn-redondo" type="button" data-camara title="Cambiar cámara (C)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h3l2-3h8l2 3h3v11H3z" /><circle cx="12" cy="13" r="3.5" /></svg>
        <span class="etiqueta-camara" data-etiqueta-camara>3ª</span>
        <span class="sr-only">Cambiar cámara</span>
      </button>
      <button class="btn-redondo" type="button" data-ver-carrito>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h8.6a1.5 1.5 0 0 0 1.4-1.1L21 8H6.2" /><circle cx="9.5" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></svg>
        <span class="sr-only">Carrito</span>
        <span class="contador" data-contador hidden>0</span>
      </button>
    </div>
  </header>

  <!-- Aviso del producto que está enfrente, y de las cajas -->
  <div class="avisos">
    <button class="enfoco" type="button" data-enfoco hidden>
      <span class="enfoco-nombre" data-enfoco-nombre></span>
      <span class="enfoco-precio precio" data-enfoco-precio></span>
      <span class="enfoco-tecla" data-enfoco-tecla>Ver (E)</span>
    </button>
    <button class="pagar" type="button" data-pagar-aviso hidden>Pagar en la caja →</button>
  </div>
  <div class="mira" data-mira hidden aria-hidden="true"></div>
  <p class="teclas" data-teclas hidden><kbd>P</kbd> ir a pagar · <kbd>C</kbd> cámara · <kbd>Esc</kbd> soltar el mouse</p>

  <!-- Celular -->
  <div class="joystick" data-joystick hidden>
    <div class="joystick-perilla" data-perilla></div>
  </div>
  <button class="btn-vr" type="button" data-vr hidden>Entrar en VR</button>

  <!-- Inicio: elegir la cámara -->
  <section class="inicio" data-inicio aria-labelledby="inicio-titulo">
    <div class="inicio-caja">
      <h2 id="inicio-titulo">Bienvenido a la tienda</h2>
      <p>Recorra los pasillos, acérquese a lo que le guste y agréguelo al carrito.</p>
      <div class="personaje" data-personaje>
        <p class="inicio-pregunta">Su personaje</p>
        <div class="personaje-fila">
          <span>Persona</span>
          <div class="chips" data-grupo="mujer">
            <button type="button" data-valor="0">Hombre</button>
            <button type="button" data-valor="1">Mujer</button>
          </div>
        </div>
        <div class="personaje-fila">
          <span>Piel</span>
          <div class="chips" data-grupo="oscura">
            <button type="button" data-valor="0">Clara</button>
            <button type="button" data-valor="1">Oscura</button>
          </div>
        </div>
        <div class="personaje-fila">
          <span>Peinado</span>
          <div class="chips" data-grupo="peinado">
            <button type="button" data-valor="0"></button>
            <button type="button" data-valor="1"></button>
            <button type="button" data-valor="2"></button>
          </div>
        </div>
        <div class="personaje-fila">
          <span>Remera</span>
          <div class="colores" data-grupo="remera"></div>
        </div>
        <div class="personaje-fila">
          <span>Pantalón</span>
          <div class="colores" data-grupo="pantalon"></div>
        </div>
        <p class="personaje-nota" data-personaje-nota>Se guarda en este navegador: la próxima vez entra con el mismo personaje.</p>
      </div>
      <p class="inicio-pregunta">¿Cómo quiere recorrerla?</p>
      <div class="inicio-opciones">
        <button type="button" class="opcion" data-empezar="tercera">
          <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="14" r="6" /><path d="M14 40v-8a10 10 0 0 1 20 0v8" /><path d="M6 44l8-6M42 44l-8-6" /></svg>
          <strong>Tercera persona</strong>
          <span>Se ve a usted caminando, la cámara lo sigue desde atrás.</span>
        </button>
        <button type="button" class="opcion" data-empezar="primera">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M4 24s7-12 20-12 20 12 20 12-7 12-20 12S4 24 4 24z" /><circle cx="24" cy="24" r="6" /></svg>
          <strong>Primera persona</strong>
          <span>Ve la tienda con sus propios ojos.</span>
        </button>
      </div>
      <p class="inicio-ayuda" data-ayuda-pc>
        <kbd>W</kbd>/<kbd>S</kbd> adelante y atrás · <kbd>A</kbd>/<kbd>D</kbd> girar · <kbd>Shift</kbd> correr · mouse para mirar · clic o <kbd>E</kbd> ver producto · <kbd>C</kbd> cambiar cámara · <kbd>P</kbd> ir a pagar
      </p>
      <p class="inicio-ayuda" data-ayuda-tactil hidden>
        Joystick: arriba y abajo para caminar, a los lados para girar · arrastre para mirar · toque un producto para verlo
      </p>
      <p class="inicio-cargando" data-cargando hidden>Armando la tienda…</p>
    </div>
  </section>

  <!-- Producto en la mano: el panel no tapa el producto, que se ve en 3D y se puede girar -->
  <section class="mano" data-mano hidden aria-labelledby="mano-nombre">
    <p class="mano-ayuda">En la mano · arrastre para darlo vuelta</p>
    <p class="ficha-cat" data-ficha-cat></p>
    <h2 id="mano-nombre" data-ficha-nombre></h2>
    <p class="ficha-precio precio" data-ficha-precio></p>
    <p class="ficha-stock" data-ficha-stock></p>
    <p class="ficha-resumen" data-ficha-resumen></p>
    <div class="hoja-pie">
      <button class="btn btn-borde" type="button" data-devolver>Devolver al estante</button>
      <button class="btn" type="button" data-agregar>Al carrito</button>
    </div>
  </section>

  <!-- Carrito -->
  <dialog class="hoja" data-carrito aria-labelledby="carrito-titulo">
    <h2 id="carrito-titulo">Su carrito</h2>
    <ul class="carrito-lista" data-carrito-lista></ul>
    <p class="carrito-vacio" data-carrito-vacio>Todavía no agregó productos.</p>
    <p class="carrito-total" data-carrito-total></p>
    <div class="hoja-pie">
      <button class="btn btn-borde" type="button" data-cerrar>Seguir comprando</button>
      <button class="btn" type="button" data-ir-caja>Ir a pagar</button>
      <a class="btn" data-ir-pagar hidden>Pagar ahora</a>
    </div>
  </dialog>

  <p class="aviso" data-aviso role="status" aria-live="polite" hidden></p>
</main>

<script>
  import { crearCliente, formato, leerPerfil, pintarPrecio, type Carrito } from '../../scripts/tienda-api';
  import { codificar, decodificar, codigoAlAzar, CODIGOS, COLORES_REMERA, COLORES_PANTALON, PEINADOS_NOMBRES } from '../../scripts/tienda3d/codigo';
  import type { Motor, Modo } from '../../scripts/tienda3d/motor';
  import type { Producto3D } from '../../scripts/tienda3d/escena';

  const raiz = document.querySelector<HTMLElement>('.t3d')!;
  const productos: Producto3D[] = JSON.parse(raiz.dataset.productos || '[]');
  const urlPagar = raiz.dataset.pagar!;
  const cliente = crearCliente(raiz.dataset.api!);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
  const tactil = matchMedia('(pointer: coarse)').matches;

  $('[data-ayuda-pc]').hidden = tactil;
  $('[data-ayuda-tactil]').hidden = !tactil;
  $<HTMLAnchorElement>('[data-ir-pagar]').href = urlPagar;
  $('[data-enfoco-tecla]').textContent = tactil ? 'Tocar para ver' : 'Ver (E)';

  // ---------- avisos ----------
  const aviso = $('[data-aviso]');
  let temporizador = 0;
  function avisar(texto: string) {
    aviso.textContent = texto;
    aviso.hidden = false;
    clearTimeout(temporizador);
    temporizador = window.setTimeout(() => (aviso.hidden = true), 2600);
  }

  // Errores de red del navegador («Failed to fetch») en palabras del cliente.
  const mensajeError = (e: unknown) =>
    e instanceof TypeError ? 'No hay conexión con la tienda. Intente de nuevo.' : (e as Error)?.message || 'No se pudo agregar. Intente de nuevo.';

  // ---------- carrito ----------
  let carrito: Carrito | null = null;
  function pintarContador() {
    const c = $('[data-contador]');
    const n = carrito?.items_count ?? 0;
    c.textContent = String(n);
    c.hidden = n === 0;
  }
  /** Lo que hay en el carrito real se ve adentro del carrito 3D que empuja el comprador. */
  const sincronizar3D = () =>
    motor?.ponerCarrito((carrito?.items ?? []).map((i) => ({ id: i.id, cantidad: i.quantity })));
  async function cargarCarrito() {
    carrito = await cliente.carrito();
    pintarContador();
    sincronizar3D();
    return carrito;
  }
  if (cliente.tieneCarrito()) cargarCarrito().catch(() => {});

  async function agregar(p: Producto3D) {
    if (!p.enStock) throw new Error('Este producto está agotado por ahora.');
    carrito = await cliente.agregar(p.id);
    pintarContador();
    sincronizar3D();
  }

  // ---------- producto en la mano ----------
  // El comprador lo levanta del estante (el motor lo anima hasta sus manos), lo mira y decide:
  // «Devolver al estante» (vuelve a su lugar) o «Al carrito» (cae en el carrito y se agrega de verdad).
  const mano = $('[data-mano]');
  let enMano: Producto3D | null = null;
  function abrirFicha(p: Producto3D) {
    enMano = p;
    $('[data-ficha-cat]').textContent = p.categoria;
    $('[data-ficha-nombre]').textContent = p.nombre;
    pintarPrecio($('[data-ficha-precio]'), p.precio, p.precioAnterior, p.descuento);
    $('[data-ficha-stock]').textContent = p.stock;
    $('[data-ficha-stock]').classList.toggle('agotado', !p.enStock);
    $('[data-ficha-resumen]').textContent = p.resumen;
    const b = $<HTMLButtonElement>('[data-agregar]');
    b.disabled = !p.enStock;
    b.textContent = p.enStock ? 'Al carrito' : 'Agotado';
    $('[data-enfoco]').hidden = true;
    mano.hidden = false;
  }
  async function devolver() {
    if (!enMano) return;
    mano.hidden = true;
    enMano = null;
    await motor?.soltar('estante');
  }
  $('[data-devolver]').addEventListener('click', devolver);
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && enMano) devolver();
  });
  $('[data-agregar]').addEventListener('click', async () => {
    if (!enMano) return;
    const p = enMano;
    const b = $<HTMLButtonElement>('[data-agregar]');
    b.disabled = true;
    b.textContent = 'Agregando…';
    try {
      await agregar(p);
      mano.hidden = true;
      enMano = null;
      avisar(`Al carrito: ${p.nombre}`);
      await motor?.soltar('carrito');
    } catch (e) {
      avisar(mensajeError(e));
      b.disabled = false;
      b.textContent = 'Al carrito';
    }
  });

  // ---------- ver carrito ----------
  const hojaCarrito = $<HTMLDialogElement>('[data-carrito]');
  // En la caja: el mismo panel, con el cajero esperando y el botón para pagar.
  let enCaja = false;
  async function abrirCarrito(caja = false) {
    enCaja = caja;
    $('#carrito-titulo').textContent = caja ? 'En la caja' : 'Su carrito';
    if (enMano) await devolver();
    motor?.pausar(true);
    if (document.pointerLockElement) document.exitPointerLock();
    hojaCarrito.showModal();
    const lista = $('[data-carrito-lista]');
    lista.replaceChildren();
    try {
      const c = cliente.tieneCarrito() ? await cargarCarrito() : null;
      const items = c?.items ?? [];
      $('[data-carrito-vacio]').hidden = items.length > 0;
      $('[data-ir-pagar]').hidden = items.length === 0 || !enCaja;
      $('[data-ir-caja]').hidden = items.length === 0 || enCaja;
      $('[data-carrito-total]').textContent = c && items.length ? `Total: ${formato(c.totals.total_price, c.totals)}` : '';
      for (const it of items) {
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = it.images[0]?.thumbnail ?? '';
        img.alt = '';
        img.width = img.height = 48;
        const nombre = document.createElement('span');
        nombre.textContent = `${it.quantity} × ${it.name}`;
        const total = document.createElement('strong');
        total.textContent = formato(it.totals.line_total, it.totals);
        li.append(img, nombre, total);
        lista.append(li);
      }
    } catch {
      $('[data-carrito-vacio]').hidden = false;
      $('[data-carrito-vacio]').textContent = 'No se pudo cargar el carrito. Revise su conexión.';
    }
  }
  $('[data-ver-carrito]').addEventListener('click', () => abrirCarrito(false));
  // «Ir a pagar»: el comprador camina solo, con su carrito, hasta la caja.
  function irAPagar() {
    if (hojaCarrito.open) hojaCarrito.close();
    if (!motor) return void (location.href = urlPagar);
    if (document.pointerLockElement) document.exitPointerLock();
    motor.irACaja();
    avisar('Yendo a la caja…');
  }
  $('[data-ir-caja]').addEventListener('click', irAPagar);
  // Tecla P: ir a pagar desde cualquier lado (en primera persona el mouse mira, no hace clic en botones).
  addEventListener('keydown', async (e) => {
    if (e.code !== 'KeyP' || !motor || e.repeat) return;
    if ((e.target as HTMLElement | null)?.closest?.('input, textarea, select') || hojaCarrito.open) return;
    if (enMano) await devolver();
    const c = carrito ?? (cliente.tieneCarrito() ? await cargarCarrito().catch(() => null) : null);
    if (!c?.items_count) return avisar('Su carrito está vacío: agregue algo antes de pagar.');
    irAPagar();
  });
  $('[data-pagar-aviso]').addEventListener('click', () => abrirCarrito(true));

  for (const d of [hojaCarrito]) {
    d.addEventListener('close', () => motor?.pausar(false));
    d.addEventListener('click', (e) => {
      if (e.target === d || (e.target as HTMLElement).closest('[data-cerrar]')) d.close();
    });
  }

  // ---------- motor 3D (se descarga al entrar) ----------
  let motor: Motor | null = null;
  const etiquetaCamara = $('[data-etiqueta-camara]');
  const pintarCamara = (m: Modo) => {
    etiquetaCamara.textContent = m === 'tercera' ? '3ª' : '1ª';
    $('[data-mira]').hidden = m !== 'primera';
    $('[data-teclas]').hidden = tactil;
  };

  // ---------- su personaje ----------
  // Se elige una vez y queda guardado: en este navegador y, si inició sesión, en su cuenta (así es el
  // mismo en el celular y en la computadora). El primero que ve es uno al azar, que también se guarda.
  const CLAVE_PERSONAJE = 'tindershop-aspecto';
  let aspecto = (() => {
    const cuenta = leerPerfil()?.personaje;
    if (cuenta && cuenta > 0) return cuenta;
    try {
      const guardado = Number(localStorage.getItem(CLAVE_PERSONAJE));
      if (guardado > 0 && guardado <= CODIGOS) return guardado;
    } catch {
      /* sin almacenamiento */
    }
    return codigoAlAzar();
  })();
  let guardarEnCuenta = 0;
  function guardarPersonaje() {
    try {
      localStorage.setItem(CLAVE_PERSONAJE, String(aspecto));
    } catch {
      /* sin almacenamiento: dura mientras la página esté abierta */
    }
    if (!cliente.conSesion() || leerPerfil()?.personaje === aspecto) return;
    clearTimeout(guardarEnCuenta);
    guardarEnCuenta = window.setTimeout(() => cliente.guardarPersonaje(aspecto).catch(() => {}), 600);
  }
  guardarPersonaje();
  const panelPersonaje = $('[data-personaje]');
  if (cliente.conSesion()) $('[data-personaje-nota]').textContent = 'Se guarda en su cuenta: es el mismo en cualquier dispositivo.';
  for (const [grupo, colores] of [['remera', COLORES_REMERA], ['pantalon', COLORES_PANTALON]] as const) {
    const caja = panelPersonaje.querySelector(`[data-grupo="${grupo}"]`)!;
    colores.forEach((c, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.valor = String(i);
      b.style.background = c;
      b.setAttribute('aria-label', `${grupo === 'remera' ? 'Remera' : 'Pantalón'} color ${i + 1}`);
      caja.append(b);
    });
  }
  function pintarPersonaje() {
    const e = decodificar(aspecto);
    const valores: Record<string, number> = { mujer: +e.mujer, oscura: +e.oscura, peinado: e.peinado, remera: e.remera, pantalon: e.pantalon };
    panelPersonaje.querySelectorAll<HTMLElement>('[data-grupo]').forEach((g) => {
      g.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.setAttribute('aria-pressed', String(Number(b.dataset.valor) === valores[g.dataset.grupo!])),
      );
    });
    const nombres = PEINADOS_NOMBRES[e.mujer ? 'mujer' : 'hombre'];
    panelPersonaje.querySelectorAll<HTMLButtonElement>('[data-grupo="peinado"] button').forEach((b, i) => (b.textContent = nombres[i]));
  }
  panelPersonaje.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-valor]');
    const g = b?.closest<HTMLElement>('[data-grupo]')?.dataset.grupo;
    if (!b || !g) return;
    const e = decodificar(aspecto);
    const v = Number(b.dataset.valor);
    if (g === 'mujer') e.mujer = v === 1;
    if (g === 'oscura') e.oscura = v === 1;
    if (g === 'peinado') e.peinado = v;
    if (g === 'remera') e.remera = v;
    if (g === 'pantalon') e.pantalon = v;
    aspecto = codificar(e);
    pintarPersonaje();
    guardarPersonaje();
  });
  pintarPersonaje();

  // ---------- música (como en una tienda de verdad) ----------
  // Arranca con el clic de «Tercera / Primera persona» (los navegadores no dejan sonar nada antes).
  const ajustesMusica: { canciones: { url: string; titulo: string }[]; apagada: boolean } = JSON.parse(raiz.dataset.musica || '{"canciones":[],"apagada":false}');
  let silencio = (() => {
    try {
      return localStorage.getItem('tindershop-musica') === 'no';
    } catch {
      return false;
    }
  })();
  let musica: import('../../scripts/tienda3d/musica').Musica | null = null;
  async function iniciarMusica() {
    if (ajustesMusica.apagada) return;
    const { crearMusica } = await import('../../scripts/tienda3d/musica');
    musica = crearMusica(ajustesMusica.canciones, (titulo) => titulo && !silencio && avisar(`♪ ${titulo}`));
    $('[data-musica-boton]').hidden = false;
    $('[data-musica-tachado]').hidden = !silencio;
    musica.silenciar(silencio);
    musica.iniciar();
  }
  $('[data-musica-boton]').addEventListener('click', () => {
    silencio = !silencio;
    musica?.silenciar(silencio);
    $('[data-musica-tachado]').hidden = !silencio;
    try {
      localStorage.setItem('tindershop-musica', silencio ? 'no' : 'si');
    } catch {
      /* sin almacenamiento */
    }
  });

  async function empezar(modo: Modo) {
    $('[data-cargando]').hidden = false;
    raiz.querySelectorAll<HTMLButtonElement>('[data-empezar]').forEach((b) => (b.disabled = true));
    await document.fonts?.ready;
    const { iniciarMotor } = await import('../../scripts/tienda3d/motor');
    // Personas realistas (modelos CC0 de Quaternius). Si no cargan, quedan las personas de figuras.
    let crearPersona;
    try {
      $('[data-cargando]').textContent = 'Armando la tienda y sus personas…';
      const { cargarPersonas } = await import('../../scripts/tienda3d/personaReal');
      crearPersona = await cargarPersonas(raiz.dataset.modelos!);
    } catch {
      crearPersona = undefined;
    }
    const enfoco = $('[data-enfoco]');
    motor = iniciarMotor($('[data-lienzo]'), productos, {
      enFoco(p) {
        enfoco.hidden = !p;
        if (p) {
          $('[data-enfoco-nombre]').textContent = p.nombre;
          pintarPrecio($('[data-enfoco-precio]'), p.precio, p.precioAnterior, p.descuento);
        }
      },
      elegir: abrirFicha,
      llegoACaja() {
        avisar('¡Hola! Bienvenido a la caja.');
        abrirCarrito(true);
      },
      enCajas(si) {
        $('[data-pagar-aviso]').hidden = !si || !(carrito?.items_count);
      },
      async agregarVR(p) {
        try {
          await agregar(p);
          return `Agregado: ${p.nombre}`;
        } catch (e) {
          return mensajeError(e);
        }
      },
    }, modo, { aspecto, pasillos: JSON.parse(raiz.dataset.pasillos || '[]'), crearPersona });
    pintarCamara(modo);
    // Multijugador: ver a los demás compradores que están en la tienda en este momento.
    const { iniciarPresencia } = await import('../../scripts/tienda3d/presencia');
    const gente = $('[data-gente]');
    iniciarPresencia(raiz.dataset.presencia!, aspecto, () => motor!.propio(), (otros) => {
      motor?.otros(otros);
      gente.hidden = otros.length === 0;
      $('[data-gente-n]').textContent = otros.length === 1 ? '1 persona más en la tienda' : `${otros.length} personas más en la tienda`;
    });
    sincronizar3D();
    iniciarMusica();
    // ?depurar en la dirección: el motor queda en window.tienda3d (para pruebas).
    if (new URLSearchParams(location.search).has('depurar')) Object.assign(window, { tienda3d: motor });
    $('[data-inicio]').hidden = true;
    try {
      sessionStorage.removeItem('tindershop-recargado');
    } catch {
      /* sin almacenamiento */
    }
    if (tactil) {
      $('[data-joystick]').hidden = false;
      $('[data-zona-mirar]').hidden = false;
    }
    if (await motor.vrDisponible()) $('[data-vr]').hidden = false;
  }
  raiz.querySelectorAll<HTMLButtonElement>('[data-empezar]').forEach((b) =>
    b.addEventListener('click', () => empezar(b.dataset.empezar as Modo).catch((e) => {
      console.error('Tienda 3D:', e);
      const texto = String((e as Error)?.message ?? e);
      // Después de una actualización del sitio, una pestaña vieja pide archivos que ya no existen:
      // se recarga sola una vez para traer la versión nueva.
      if (/dynamically imported module|Importing a module script failed|error loading dynamically|Failed to fetch/i.test(texto)) {
        try {
          if (!sessionStorage.getItem('tindershop-recargado')) {
            sessionStorage.setItem('tindershop-recargado', '1');
            location.reload();
            return;
          }
        } catch {
          /* sin almacenamiento */
        }
      }
      motor = null;
      raiz.querySelectorAll<HTMLButtonElement>('[data-empezar]').forEach((b) => (b.disabled = false));
      $('[data-cargando]').textContent = /webgl|context/i.test(texto)
        ? 'Su navegador tiene apagados los gráficos 3D (WebGL). Active la «aceleración por hardware» en la configuración del navegador y reinícielo, o pruebe con las tarjetas.'
        : `Su navegador no pudo abrir la tienda 3D (${texto.slice(0, 120)}). Vuelva a intentar o pruebe con las tarjetas.`;
    })),
  );
  $('[data-camara]').addEventListener('click', () => motor && pintarCamara(motor.cambiarModo()));
  addEventListener('keydown', (e) => {
    if (e.code === 'KeyC' && motor) setTimeout(() => pintarCamara(motor!.modo()));
  });
  $('[data-enfoco]').addEventListener('click', () => motor?.elegirEnFoco());
  $('[data-vr]').addEventListener('click', () => motor?.entrarVR().catch(() => avisar('No se pudo entrar en VR.')));

  // ---------- celular: joystick y mirar ----------
  const joy = $('[data-joystick]');
  const perilla = $('[data-perilla]');
  let dedoJoy: number | null = null;
  function moverJoy(e: PointerEvent) {
    const r = joy.getBoundingClientRect();
    const radio = r.width / 2;
    let dx = e.clientX - (r.left + radio);
    let dy = e.clientY - (r.top + radio);
    const d = Math.hypot(dx, dy);
    if (d > radio) {
      dx = (dx / d) * radio;
      dy = (dy / d) * radio;
    }
    perilla.style.transform = `translate(${dx}px, ${dy}px)`;
    motor?.joystick(dx / radio, -dy / radio);
  }
  joy.addEventListener('pointerdown', (e) => {
    dedoJoy = e.pointerId;
    joy.setPointerCapture(e.pointerId);
    moverJoy(e);
  });
  joy.addEventListener('pointermove', (e) => e.pointerId === dedoJoy && moverJoy(e));
  const soltarJoy = (e: PointerEvent) => {
    if (e.pointerId !== dedoJoy) return;
    dedoJoy = null;
    perilla.style.transform = '';
    motor?.joystick(0, 0);
  };
  joy.addEventListener('pointerup', soltarJoy);
  joy.addEventListener('pointercancel', soltarJoy);

  const zona = $('[data-zona-mirar]');
  const dedos = new Map<number, { x: number; y: number; x0: number; y0: number }>();
  let pellizco = 0;
  zona.addEventListener('pointerdown', (e) => {
    zona.setPointerCapture(e.pointerId);
    dedos.set(e.pointerId, { x: e.clientX, y: e.clientY, x0: e.clientX, y0: e.clientY });
  });
  zona.addEventListener('pointermove', (e) => {
    const d = dedos.get(e.pointerId);
    if (!d) return;
    if (dedos.size === 2) {
      // Pellizco: zoom de la cámara de tercera persona.
      const [a, b] = [...dedos.values()];
      const antes = Math.hypot(a.x - b.x, a.y - b.y);
      d.x = e.clientX;
      d.y = e.clientY;
      const ahora = Math.hypot(a.x - b.x, a.y - b.y);
      if (pellizco) motor?.zoom((antes - ahora) * 6);
      pellizco = ahora;
      return;
    }
    motor?.mirar(e.clientX - d.x, e.clientY - d.y);
    d.x = e.clientX;
    d.y = e.clientY;
  });
  const soltar = (e: PointerEvent) => {
    const d = dedos.get(e.pointerId);
    dedos.delete(e.pointerId);
    pellizco = 0;
    // Toque sin arrastrar: elegir lo que hay bajo el dedo.
    if (d && Math.hypot(e.clientX - d.x0, e.clientY - d.y0) < 8 && e.type === 'pointerup') motor?.elegirEn(e.clientX, e.clientY);
  };
  zona.addEventListener('pointerup', soltar);
  zona.addEventListener('pointercancel', soltar);
</script>

