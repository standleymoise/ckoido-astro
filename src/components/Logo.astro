---
import { url, marca } from '../data/sitio';
// Logo de Tindershop (public/img/logo-tindershop.svg): dos tarjetas del swipe con una bolsa y la
// palabra en trazos (no depende de la fuente). Proporción 270 × 56.
interface Props {
  /** Ancho del logo en px (cabecera: 184, pie: 232). */
  size?: number;
  href?: string;
}
const { size = 184, href = url('/') } = Astro.props;
---
<a class="logo" href={href} style={`--u:${+(size / 184).toFixed(4)}`} aria-label={`${marca.nombre}, inicio`}>
  <img src={url('/img/logo-tindershop.svg')} alt="" width="270" height="56" />
</a>

<style>
  /* --u es la escala (1 = 184 px de ancho). Las páginas pueden cambiarla, p. ej. en el celular. */
  .logo {
    --u: 1;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .logo img {
    width: calc(184px * var(--u));
    height: auto;
  }
</style>
