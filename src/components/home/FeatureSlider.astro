---
const tarjetas = [
  {
    numero: '01',
    titulo: 'Prevención de infecciones:',
    texto:
      'CK Oído ayuda a evitar infecciones en los oídos al eliminar el agua atrapada en el conducto auditivo externo. El agua puede proporcionar un ambiente propicio para el crecimiento de bacterias y hongos, lo que aumenta el riesgo de infecciones. Al secar eficientemente los oídos, el producto reduce este riesgo y promueve la salud auditiva.',
  },
  {
    numero: '02',
    titulo: 'Secado eficiente:',
    texto:
      'Este producto ofrece un secado eficiente y rápido de los oídos. Sus ingredientes están formulados para absorber y evaporar el agua de manera efectiva, evitando así la incomodidad y los problemas de salud relacionados con el exceso de humedad en los oídos. Al secar rápidamente los oídos, CK Oído ayuda a reducir la sensación de bloqueo, zumbidos o malestar que se puede experimentar después de la exposición al agua.',
  },
  {
    numero: '03',
    titulo: 'Fácil de usar:',
    texto:
      'CK Oído en niños puede aplicar 2-3 gotas para limpieza o secado de la oreja, únicamente acerque el gotero (sin que toque la oreja) y aplique las gotas. En adultos puede aplicar de 3-5 gotas para limpieza o secado de la oreja, únicamente acerque el gotero (sin que toque la oreja) y aplique las gotas.',
  },
  {
    numero: '04',
    titulo: 'Seguro y suave:',
    texto:
      'CK Oído ha sido desarrollado pensando en la seguridad y la comodidad del usuario. Está diseñado para ser suave con la piel y el sistema auditivo. Los ingredientes utilizados son seguros y no irritantes, minimizando así las reacciones adversas.',
  },
];
---
<section class="ventajas container" aria-roledescription="carrusel" aria-label="Ventajas de CK Oído" data-slider>
  <ul class="pista" tabindex="0" aria-label="Tarjetas de ventajas (desplázate horizontalmente)" data-pista>
    {tarjetas.map((t, i) => (
      <li class="tarjeta" role="group" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${tarjetas.length}`}>
        <span class="numero" aria-hidden="true">{t.numero}</span>
        <div>
          <h3>{t.titulo}</h3>
          <p>{t.texto}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="puntos" data-puntos>
    {tarjetas.map((_, i) => (
      <button type="button" aria-label={`Ir a la tarjeta ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>
    ))}
  </div>
</section>

<script>
  // Carrusel sin librerías: la pista hace scroll con snap y los puntos se generan
  // según cuántas tarjetas caben (2 en escritorio, 1 en móvil).
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const pista = slider.querySelector<HTMLElement>('[data-pista]')!;
    const puntos = slider.querySelector<HTMLElement>('[data-puntos]')!;
    const tarjetas = Array.from(pista.children) as HTMLElement[];
    let botones: HTMLButtonElement[] = [];
    const suave = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');

    const porVista = () => {
      const ancho = tarjetas[0].getBoundingClientRect().width;
      return Math.max(1, Math.round(pista.clientWidth / ancho));
    };
    const paso = () => (tarjetas[1] ? tarjetas[1].offsetLeft - tarjetas[0].offsetLeft : pista.clientWidth);

    const marcar = () => {
      const max = pista.scrollWidth - pista.clientWidth;
      let idx = Math.round(pista.scrollLeft / paso());
      if (pista.scrollLeft >= max - 2) idx = botones.length - 1;
      botones.forEach((b, i) => {
        if (i === idx) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
    };

    const construir = () => {
      const total = Math.max(1, tarjetas.length - porVista() + 1);
      if (total === botones.length) return marcar();
      puntos.replaceChildren();
      botones = Array.from({ length: total }, (_, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', `Ir a la tarjeta ${i + 1}`);
        b.addEventListener('click', () => pista.scrollTo({ left: tarjetas[i].offsetLeft - tarjetas[0].offsetLeft, behavior: suave() }));
        puntos.append(b);
        return b;
      });
      puntos.hidden = total < 2;
      marcar();
    };

    let raf = 0;
    pista.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(marcar);
    }, { passive: true });
    new ResizeObserver(construir).observe(pista);
    construir();
  });
</script>

<style>
  /* Dos tarjetas de 809×275 separadas 48px (Figma 1920) */
  .ventajas {
    padding-top: clamp(56px, 4.5vw, 87px);
  }

  .pista {
    --gap: clamp(16px, 2.5vw, 48px);
    display: flex;
    gap: var(--gap);
    margin: 0;
    /* aire para que la sombra de las tarjetas no se corte */
    padding: 4px 4px 24px;
    margin-inline: -4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 4px;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .pista:focus-visible {
    outline: 3px solid #ffb3c4;
    outline-offset: 2px;
    border-radius: 20px;
  }

  .tarjeta {
    flex: 0 0 calc((100% - var(--gap)) / 2);
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: clamp(20px, 2.2vw, 42px);
    min-height: clamp(220px, 14.33vw, 275px);
    padding: clamp(20px, 1.2vw, 23px) clamp(20px, 1.6vw, 30px) clamp(20px, 1.2vw, 23px) clamp(20px, 2.2vw, 43px);
    border: 1px solid rgba(34, 103, 180, 0.24);
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 100%), #fff;
    box-shadow: 3px 4px 20px rgba(4, 116, 186, 0.1);
  }

  .numero {
    font-weight: 800;
    font-style: italic;
    font-size: clamp(72px, 7.8vw, 150px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--azul-600);
    padding-right: 0.06em;
  }

  h3 {
    margin: clamp(0px, 0.86vw, 16px) 0 clamp(8px, 0.7vw, 13px);
    font-weight: 600;
    font-size: clamp(18px, 1.04vw, 20px);
    line-height: 1.602;
    color: #084780;
  }

  p {
    margin: 0;
    font-size: clamp(15px, 0.83vw, 16px);
    line-height: 1.602;
    color: var(--texto);
  }

  .puntos {
    display: flex;
    justify-content: center;
    margin-top: clamp(0px, 0.4vw, 8px);
  }
  .puntos button {
    width: 24px;
    height: 24px;
    margin-inline: -5px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .puntos button::before {
    content: '';
    width: 9.6px;
    height: 9.6px;
    border-radius: 50%;
    background: #d9d9d9;
    transition: background-color 0.2s, transform 0.2s;
  }
  .puntos button:hover::before {
    background: #f28aa2;
  }
  .puntos button[aria-current='true']::before {
    background: var(--rojo);
  }
  .puntos button:focus-visible {
    outline-offset: -2px;
    border-radius: 50%;
  }

  @media (max-width: 960px) {
    .tarjeta {
      flex-basis: 100%;
    }
  }

  @media (max-width: 520px) {
    .tarjeta {
      grid-template-columns: 1fr;
    }
    .numero {
      font-size: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }
  }
</style>
