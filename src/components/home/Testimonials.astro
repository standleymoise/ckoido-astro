---
import { Image } from 'astro:assets';
import karol from '../../assets/home/avatar-karol.png';
import daniela from '../../assets/home/avatar-daniela.png';
import maria from '../../assets/home/avatar-maria.png';
import carlos from '../../assets/home/avatar-carlos.png';
import ana from '../../assets/home/avatar-ana.png';

// Orden de lectura por filas, igual que en el Figma.
// Nota: en el Figma, Gabriel R. reutiliza la foto de María A.
const historias = [
  { nombre: 'Karol R.', foto: karol, etiqueta: 'Mi mejor acompañante', texto: 'Tuve muchos problemas con mi oído y esta fue la mejor solución.' },
  { nombre: 'Daniela T.', foto: daniela, etiqueta: 'Satisfecha', texto: 'Encontré resultados increíbles luego del uso de CK Oído.' },
  { nombre: 'María A.', foto: maria, etiqueta: 'Feliz', texto: 'Viajo con ellas a cualquier lado que pueda haber piscina o mar.' },
  { nombre: 'Carlos S.', foto: carlos, etiqueta: 'Único', texto: 'Actualmente voy a nadar y ayuda mucho a que no se quede el agua en mis oídos y me ayudan a prevenir infecciones.' },
  { nombre: 'Ana M.', foto: ana, etiqueta: 'Recomendado', texto: 'La utilizo después de mis sesiones de surf, me ayudan a prevenir infecciones.' },
  { nombre: 'Gabriel R.', foto: maria, etiqueta: 'Increíble', texto: 'Me encanta usarlas después de bañarme, me ayudan a quitar la sensación del agua y evitar infecciones.' },
];
---
<section class="historias" aria-labelledby="historias-titulo">
  <div class="container">
    <h2 id="historias-titulo">Historias que hablan por sí solas</h2>
    <p class="intro">
      CK Oído se ha convertido en la gran solución para evitar la mayoría de infecciones del oído externo. Nuestros
      consumidores han encontrado en CK Oído la respuesta que tanto buscaban. Nuestros clientes satisfechos han
      experimentado un alivio inmediato, gracias a la fórmula especializada que combate la humedad generada en el oído,
      al mismo tiempo que lubrica. Adiós a la sensación de oído húmedo con CK Oído.
    </p>

    <ul class="lista">
      {historias.map((h) => (
        <li>
          <figure class="tarjeta">
            <figcaption class="autor">
              <Image class="avatar" src={h.foto} alt="" format="webp" widths={[80, 161]} sizes="80px" />
              <span class="nombre">{h.nombre}</span>
            </figcaption>
            <p class="etiqueta">{h.etiqueta}</p>
            <blockquote>
              <p>{h.texto}</p>
            </blockquote>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Banda gris de 844px (Figma 1920) */
  .historias {
    margin-top: clamp(40px, 3.5vw, 67px);
    padding-block: clamp(48px, 3.07vw, 59px) clamp(48px, 3.6vw, 69px);
    background: rgba(243, 243, 243, 0.84);
  }

  h2 {
    margin: 0;
    text-align: center;
    font-weight: 700;
    font-size: clamp(28px, 2.08vw, 40px);
    line-height: 1.21;
    color: var(--azul-900);
  }

  .intro {
    max-width: 1487px;
    margin: clamp(20px, 2.65vw, 51px) auto 0;
    text-align: center;
    font-size: clamp(15px, 0.885vw, 17px);
    line-height: 1.602;
    color: var(--texto);
  }

  /* 3 columnas de 542px con 22px / 16px de separación */
  .lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px clamp(16px, 1.15vw, 22px);
    margin: clamp(32px, 2.65vw, 51px) 0 0;
    padding: 0;
    list-style: none;
  }
  .lista li {
    display: flex;
  }

  .tarjeta {
    flex: 1;
    margin: 0;
    padding: clamp(16px, 1.04vw, 20px) clamp(20px, 1.6vw, 30px) clamp(20px, 1.4vw, 26px) clamp(24px, 2.78vw, 53px);
    border: 1px solid rgba(34, 103, 180, 0.24);
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #fff 100%), #f9fafc;
    box-shadow: 3px 4px 20px rgba(4, 116, 186, 0.1);
  }

  .autor {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.03vw, 19px);
    margin-left: clamp(-11px, -0.57vw, 0px);
  }
  .avatar {
    flex: none;
    width: clamp(60px, 4.19vw, 80px);
    height: clamp(60px, 4.19vw, 80px);
    border-radius: 50%;
    object-fit: cover;
  }
  .nombre {
    font-family: var(--font-alt);
    font-weight: 500;
    font-size: clamp(20px, 1.3vw, 25px);
    line-height: 1.2;
    color: var(--azul-900);
  }

  .etiqueta {
    margin: clamp(6px, 0.55vw, 10px) 0 0;
    font-weight: 500;
    font-size: clamp(18px, 1.09vw, 21px);
    line-height: 1.602;
    color: var(--azul-900);
  }

  blockquote {
    margin: clamp(4px, 0.4vw, 8px) 0 0;
  }
  blockquote p {
    margin: 0;
    font-size: clamp(15px, 0.885vw, 17px);
    line-height: 1.5;
    color: #7c7c7c;
  }

  @media (max-width: 1100px) {
    .lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .lista {
      grid-template-columns: 1fr;
    }
  }
</style>
