---
// Portada del inicio informativo (sin tienda): logo, lema, descripción y acceso a los productos.
import { marca, rutas, url } from '../../data/sitio';
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="contenido container">
    <img class="logo" src={url('/img/logo-tindershop.svg')} alt={marca.nombre} width="270" height="56" />
    <h1 id="hero-titulo">{marca.lema}</h1>
    <p class="descripcion">{marca.descripcion}</p>
    <div class="acciones">
      <a class="btn" href={rutas.tienda}>Ver productos</a>
      <a class="secundario" href="#como-funciona">¿Cómo funciona?</a>
    </div>
  </div>

  <div class="tarjetas" aria-hidden="true">
    <span class="carta c1"></span>
    <span class="carta c2"></span>
    <span class="carta c3">
      <span class="sello">♥</span>
    </span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(440px, 30vw, 600px);
    border-radius: 0 0 clamp(40px, 5.2vw, 100px) clamp(40px, 5.2vw, 100px);
    background: linear-gradient(0deg, var(--celeste), var(--blanco-76)), #eef5fd;
  }

  .contenido {
    position: relative;
    z-index: 1;
    padding-block: clamp(48px, 6vw, 120px);
  }
  .logo {
    display: block;
    width: clamp(200px, 16vw, 300px);
    height: auto;
  }
  h1 {
    margin: clamp(20px, 1.8vw, 34px) 0 0;
    max-width: 760px;
    font-weight: 800;
    font-size: clamp(32px, 3vw, 58px);
    line-height: 1.1;
    color: var(--azul-900);
  }
  .descripcion {
    margin: clamp(14px, 1.1vw, 22px) 0 0;
    max-width: 600px;
    font-weight: 500;
    font-size: clamp(16px, 1.05vw, 20px);
    line-height: 1.5;
    color: var(--texto);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(24px, 2.1vw, 40px);
  }
  .secundario {
    font-weight: 600;
    color: var(--azul-900);
  }

  /* Pila de tarjetas decorativa, como el mazo de la tienda */
  .tarjetas {
    position: absolute;
    right: clamp(24px, 9vw, 200px);
    top: 50%;
    width: clamp(180px, 17vw, 330px);
    aspect-ratio: 3 / 4;
    transform: translateY(-50%);
  }
  .carta {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    box-shadow: 0 18px 40px rgba(10, 67, 131, 0.18);
  }
  .c1 {
    background: var(--azul-600);
    transform: rotate(-12deg) translateX(-18%);
    opacity: 0.55;
  }
  .c2 {
    background: var(--azul-900);
    transform: rotate(-5deg) translateX(-8%);
    opacity: 0.8;
  }
  .c3 {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #fff, #e1eeff);
    border: 1px solid var(--borde);
    transform: rotate(6deg);
  }
  .sello {
    display: grid;
    place-items: center;
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--rojo);
    color: #fff;
    font-size: clamp(36px, 3.4vw, 64px);
    line-height: 1;
  }

  @media (max-width: 900px) {
    .tarjetas {
      display: none;
    }
  }
</style>
