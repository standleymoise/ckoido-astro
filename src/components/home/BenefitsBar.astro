---
import { url } from '../../data/sitio';
const beneficios = [
  { texto: 'Prevención de infecciones', icono: url('/img/home/icono-prevencion.svg') },
  { texto: 'Secado eficiente', icono: url('/img/home/icono-secado.svg') },
  { texto: 'Fácil de usar', icono: url('/img/home/icono-facil.svg') },
  { texto: 'Seguro y suave', icono: url('/img/home/icono-seguro.svg') },
];
---
<div class="beneficios container">
  <h2 class="sr-only">Beneficios de CK Oído</h2>
  <ul>
    {beneficios.map((b) => (
      <li>
        <img src={b.icono} alt="" width="75" height="75" />
        <span>{b.texto}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Barra azul de 122px que se monta 64px sobre el borde inferior del hero */
  .beneficios {
    position: relative;
    z-index: 1;
    margin-top: clamp(-64px, -3.33vw, -40px);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 16px;
    min-height: clamp(96px, 6.36vw, 122px);
    margin: 0;
    padding: 16px clamp(20px, 2.6vw, 50px);
    list-style: none;
    border-radius: 22px;
    background: linear-gradient(90deg, var(--azul-900), var(--azul-600));
  }

  li {
    display: flex;
    align-items: center;
    gap: clamp(10px, 0.95vw, 18px);
  }

  img {
    flex: none;
    width: clamp(48px, 3.92vw, 75px);
    height: auto;
  }

  span {
    font-weight: 600;
    font-size: clamp(15px, 1.15vw, 22px);
    line-height: 1.2;
    color: #fff;
  }

  @media (max-width: 960px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 18px;
      padding-block: 22px;
    }
  }

  @media (max-width: 380px) {
    img {
      width: 42px;
    }
    span {
      font-size: 14px;
    }
  }
</style>
