---
/**
 * «¿Dónde comprar?» (Figma node 148:365–392): tarjetas con borde y el logo de cada
 * farmacia; debajo, el teléfono como enlace tel:. Es el destino de todos los
 * botones «Comprar ahora» del sitio (/nosotros#donde-comprar).
 */
import { Image } from 'astro:assets';
import { farmacias, telHref } from '../../data/sitio';
import logoSantaLucia from '../../assets/nosotros/logo-santa-lucia.png';
import logoSucre from '../../assets/nosotros/logo-sucre.png';

// Recorte del logo dentro de la tarjeta, en % de la tarjeta (posición exacta del Figma).
const tarjetas = [
  {
    nombre: 'Farmacia Santa Lucía',
    logo: logoSantaLucia,
    telefono: farmacias[0].telefono,
    box: 'left:18.32%;top:-60.73%;width:63.35%;height:221.46%',
  },
  {
    nombre: 'Farmacia Sucre',
    logo: logoSucre,
    telefono: farmacias[1].telefono,
    box: 'left:24.94%;top:16.04%;width:50.13%;height:67.91%',
  },
];
---
<section id="donde-comprar" class="donde container" aria-labelledby="donde-titulo">
  <h2 id="donde-titulo">¿Dónde comprar?</h2>
  <ul class="tarjetas">
    {tarjetas.map((t) => (
      <li>
        <div class="tarjeta">
          <Image
            src={t.logo}
            alt={t.nombre}
            style={t.box}
            widths={[300, 600]}
            sizes="(max-width: 700px) 60vw, 344px"
            format="webp"
            quality={85}
            loading="lazy"
          />
        </div>
        <a class="tel" href={telHref(t.telefono)}>
          <span class="sr-only">Llamar a {t.nombre}: </span>Tel. {t.telefono}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .donde {
    padding-block: clamp(48px, 3.9vw, 74px) clamp(48px, 4.4vw, 84px);
    text-align: center;
    scroll-margin-top: 16px;
  }
  h2 {
    margin: 0 0 clamp(28px, 3.4vw, 64px);
    font-weight: 700;
    font-size: clamp(28px, 2.08vw, 40px);
    line-height: 1.25;
    color: var(--azul-900);
  }
  .tarjetas {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 542px));
    justify-content: center;
    gap: clamp(20px, 2.1vw, 40px);
  }
  .tarjeta {
    position: relative;
    overflow: hidden;
    aspect-ratio: 542 / 155;
    border: 1px solid #2267b4;
    border-radius: 20px;
    background: #fff;
  }
  .tarjeta img {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }
  .tel {
    display: inline-block;
    margin-top: 12px;
    font-weight: 600;
    font-size: 16px;
    color: var(--azul-900);
    text-decoration: none;
  }
  .tel:hover {
    text-decoration: underline;
  }
  @media (max-width: 700px) {
    .tarjetas {
      grid-template-columns: minmax(0, 420px);
    }
  }
</style>
