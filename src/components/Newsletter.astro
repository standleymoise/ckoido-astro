---
// Bloque de suscripción. Envía a Formspree (ver src/data/formularios.ts y .env.example).
import { formspree } from '../data/formularios';
---
<section class="newsletter container" aria-labelledby="newsletter-titulo">
  <div class="card">
    <img class="ondas" src="/img/ondas-boletin.svg" alt="" aria-hidden="true" />
    <div class="texto">
      <p class="kicker">Suscríbase a nuestro boletín</p>
      <h2 id="newsletter-titulo">
        <span>Para noticias y promociones</span>
        <strong>Sé parte de la familia de CK OÍDO</strong>
      </h2>
    </div>
    <div class="suscripcion">
      <form
        class="form"
        action={formspree.boletin || '#'}
        method="post"
        data-formspree
        data-ok="¡Listo! Ya es parte de la familia de CK Oído."
      >
        <input type="hidden" name="_subject" value="Nueva suscripción al boletín de ckoido.com" />
        <input type="hidden" name="formulario" value="Boletín" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trampa" aria-hidden="true" />
        <label class="sr-only" for="newsletter-email">Correo electrónico</label>
        <input id="newsletter-email" name="email" type="email" required placeholder="Ingrese su correo" autocomplete="email" />
        <button type="submit">Suscríbase</button>
      </form>
      <p class="estado" data-estado role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  import '../scripts/formspree';
</script>

<style>
  .suscripcion {
    position: relative;
    min-width: 0;
  }
  .trampa {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .estado:empty {
    display: none;
  }
  .estado {
    margin: 10px 0 0;
    padding-left: 6px;
    font-weight: 600;
    font-size: 15px;
    color: #fff;
  }
  .estado[data-tipo='error'] {
    color: #ffc9d5;
  }
  .form button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .newsletter {
    padding-block: clamp(48px, 4vw, 77px) clamp(32px, 2.1vw, 41px);
  }
  .card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr minmax(0, 775px);
    align-items: center;
    gap: 32px;
    min-height: 234px;
    padding: 32px clamp(24px, 2.6vw, 50px) 32px clamp(24px, 2.2vw, 42px);
    border-radius: 20px;
    background: linear-gradient(90deg, var(--azul-900), var(--azul-600));
    color: #fff;
  }
  .ondas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .texto,
  .form {
    position: relative;
  }
  .kicker {
    margin: 0 0 4px;
    font-size: clamp(14px, 0.88vw, 16.96px);
    line-height: 1.602;
  }
  h2 {
    margin: 0;
    font-weight: 400;
    line-height: 1.25;
  }
  h2 span {
    display: block;
    font-size: clamp(22px, 1.68vw, 32.27px);
  }
  h2 strong {
    display: block;
    font-weight: 700;
    font-size: clamp(24px, 1.95vw, 37.5px);
  }

  .form {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 75px;
    padding: 0 18px;
    border: 1px solid #fff;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 3px 4px 20px 0 rgba(4, 116, 186, 0.06);
  }
  .form input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: transparent;
    color: #fff;
    font: 500 clamp(16px, 1.15vw, 22px) / 1 var(--font-sans);
  }
  .form input::placeholder {
    color: #b8b8b8;
  }
  .form input:focus-visible {
    outline: none;
  }
  .form:focus-within {
    border-color: #ffb3c4;
  }
  .form button {
    flex: none;
    height: 40px;
    min-width: 182px;
    padding: 0 32px;
    border: 0;
    border-radius: 60px;
    background: var(--rojo);
    color: #fff;
    font: 600 18px / 1 var(--font-sans);
    cursor: pointer;
  }
  .form button:hover {
    background: #d11a43;
  }

  @media (max-width: 1100px) {
    .card {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .form {
      flex-direction: column;
      align-items: stretch;
      padding: 12px;
    }
    .form input {
      height: 48px;
      padding-inline: 6px;
    }
    .form button {
      min-width: 0;
      height: 44px;
    }
  }
</style>
