---
import { Font, getImage } from 'astro:assets';
import { url, marca } from '../data/sitio';
import InstalarApp from '../components/InstalarApp.astro';
import { tiendaUrl } from '../data/tienda';
import fotoCompartir from '../assets/compartir-tindershop.png';
interface Props {
  title: string;
  description?: string;
  /** Páginas personales (cuenta, favoritos): no se indexan. */
  noindex?: boolean;
  /** Imagen al compartir: URL absoluta, o una imagen importada de src/assets. */
  imagen?: string | ImageMetadata;
  tipo?: 'website' | 'article' | 'product';
  /** Datos estructurados (schema.org): un objeto o una lista. */
  jsonLd?: object | object[];
}
const {
  title,
  description = marca.descripcion,
  noindex = false,
  imagen = fotoCompartir,
  tipo = 'website',
  jsonLd,
} = Astro.props;
// Dominio oficial (SITE_URL). Si alguien entra por otra variante (p. ej. www.), se le manda al oficial:
// la tienda solo acepta llamadas (CORS) desde ese dominio, así que por www el carrito no funcionaría.
const hostOficial = Astro.site?.host ?? '';
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Imagen para WhatsApp/Facebook: las importadas se exportan en JPG de 1200 px (WebP no siempre se ve).
const imagenOg =
  typeof imagen === 'string'
    ? imagen
    : new URL((await getImage({ src: imagen, width: 1200, format: 'jpg' })).src, Astro.site ?? Astro.url).href;
// JSON dentro de <script>: «<» escapado para que un texto con «</script>» no rompa la página.
const ld = jsonLd ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c') : '';
---
<!doctype html>
<html lang="es">
  <head>
    <script is:inline define:vars={{ hostOficial }}>
      if (hostOficial && location.host !== hostOficial && location.host === 'www.' + hostOficial) {
        location.replace(location.protocol + '//' + hostOficial + location.pathname + location.search + location.hash);
      }
    </script>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonica} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenOg} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Abre la conexión con WooCommerce mientras carga la página: el carrito responde antes. */}
    {tiendaUrl && <link rel="preconnect" href={tiendaUrl} crossorigin />}
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('/iconos/apple-180.png')} />
    <meta name="apple-mobile-web-app-title" content={marca.nombre} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content={marca.color} />
    <Font cssVariable="--fuente-texto" preload={[{ weight: 400 }]} />
    <Font cssVariable="--fuente-titulos" />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <slot />
    <InstalarApp nombre={marca.nombre} icono={url('/iconos/icono-192.png')} color={marca.acento} clave="tindershop-instalar-cerrado" />
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: url('/sw.js'), scope: url('/') }}>
        // App instalable: el service worker guarda el sitio para abrirlo rápido y sin conexión.
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register(sw, { scope }).catch(() => {}));
        }
      </script>
    )}
  </body>
</html>

<style is:global>
  /* Precio en oferta: el normal tachado y el descuento (Precio.astro, pintarPrecio). */
  .precio del {
    margin-left: 4px;
    font-size: 0.6em;
    font-weight: 600;
    color: #7a8699;
  }
  .precio .pct {
    display: inline-block;
    margin-left: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #ed2853;
    color: #fff;
    font-size: 0.5em;
    font-weight: 800;
    vertical-align: 0.35em;
    letter-spacing: 0.02em;
  }
  .cinta-oferta {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 5px 12px;
    border-radius: 999px;
    background: #ed2853;
    color: #fff;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.06em;
    box-shadow: 0 4px 12px rgb(237 40 83 / 0.35);
    pointer-events: none;
  }
  .cinta-oferta[hidden] {
    display: none;
  }
  :root {
    --azul-900: #0a4383;
    --azul-850: #09498a;
    --azul-800: #145297;
    --azul-600: #0474ba;
    --banner-azul: #0a4584;
    --rojo: #ed2853;
    --texto: #526377;
    --morado: #342f69;
    --celeste: rgba(225, 238, 255, 0.76);
    --blanco-76: rgba(255, 255, 255, 0.76);
    --borde: rgba(4, 116, 186, 0.29);

    /* Fuentes servidas desde el propio dominio (ver «fonts» en astro.config.mjs) */
    --font-sans: var(--fuente-texto);
    --font-alt: var(--fuente-titulos), var(--fuente-texto);

    /* Ancho de contenido del Figma: 1665px dentro de 1920px */
    --gutter: clamp(16px, 6.6vw, 128px);
    --container: min(1666px, 100% - 2 * var(--gutter));
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--texto);
    background: #fff;
    overflow-x: hidden;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
  }

  .container {
    width: var(--container);
    margin-inline: auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-alt);
    font-weight: 500;
    font-size: clamp(16px, 1.05vw, 20px);
    line-height: 1.2;
    color: #fff;
    background: var(--rojo);
    border: 1px solid var(--rojo);
    border-radius: 30px;
    padding: 17px 45px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .btn:hover {
    background: #d11a43;
    border-color: #d11a43;
  }

  .btn:focus-visible,
  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 3px solid #ffb3c4;
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
