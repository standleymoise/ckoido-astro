---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import Hero from '../components/home/Hero.astro';
import ComoFunciona from '../components/home/ComoFunciona.astro';
import TiendaSwipe from '../components/tienda/TiendaSwipe.astro';
import Tienda3D from '../components/tienda3d/Tienda3D.astro';
import { getExperiencia } from '../data/ajustes';
import { getPosts } from '../data/blog';
import { marca, rutas } from '../data/sitio';
import { getProductos, tiendaActiva } from '../data/tienda';
import { getCollection } from 'astro:content';

// En modo tienda (Hostinger) el inicio es la experiencia que se eligió en WordPress
// (Ajustes → Tindershop): las tarjetas deslizables o la tienda 3D, a pantalla completa;
// en GitHub Pages es una portada sencilla de Tindershop.
const productos = await getProductos();
const experiencia = await getExperiencia();
const posts = tiendaActiva ? [] : (await getPosts()).slice(0, 3);
// Opiniones de clientes (WordPress: CPT UI «testimonios» + ACF): van mezcladas en el mazo.
const testimonios = tiendaActiva ? await getCollection('testimonios') : [];
// Banners (WordPress: CPT UI «banners» + ACF): tarjetas de promoción dentro del mazo.
const banners = tiendaActiva ? await getCollection('banners') : [];

const sitio = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': tiendaActiva ? 'OnlineStore' : 'Organization',
      name: marca.nombre,
      url: sitio,
      logo: new URL('img/logo-tindershop.svg', sitio).href,
      description: marca.descripcion,
      slogan: marca.lema,
    },
    { '@type': 'WebSite', name: marca.nombre, url: sitio, inLanguage: 'es-CR' },
  ],
};
---
<Base
  title={tiendaActiva ? `${marca.nombre} | ${marca.lema}` : `${marca.nombre} | La tienda en la que se compra deslizando`}
  description={marca.descripcion}
  jsonLd={jsonLd}
>
  {tiendaActiva ? (
    experiencia === '3d' ? (
      <Tienda3D productos={productos} />
    ) : (
      <TiendaSwipe productos={productos} testimonios={testimonios} banners={banners} />
    )
  ) : (
  <>
  <Header />
  <main>
    <Hero />
    <ComoFunciona />

    {posts.length > 0 && (
      <section class="blog container" aria-labelledby="blog-titulo">
        <div class="blog-cabeza">
          <h2 id="blog-titulo">Del blog</h2>
          <a href={rutas.blog}>Ver todos</a>
        </div>
        <ul class="blog-lista">
          {posts.map((post) => (
            <li><BlogCard post={post} /></li>
          ))}
        </ul>
      </section>
    )}

    <section class="cierre container" aria-labelledby="cierre-titulo">
      <h2 id="cierre-titulo">¿Listo para empezar?</h2>
      <p>Abra la tienda y deslice: lo que le guste, a la derecha.</p>
      <a class="btn" href={rutas.tienda}>Ver productos</a>
    </section>
  </main>
  <Footer />
  </>
  )}
</Base>

<style>
  .blog {
    padding-top: clamp(24px, 3vw, 56px);
    padding-bottom: clamp(16px, 3.3vw, 64px);
  }
  .blog-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .blog h2,
  .cierre h2 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(28px, 2.08vw, 40px);
    line-height: 1.21;
    color: var(--azul-900);
  }
  .blog-cabeza a {
    font-weight: 600;
    color: var(--rojo);
  }

  .blog-lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 40px);
    margin: clamp(28px, 3.2vw, 61px) 0 0;
    padding: 0;
    list-style: none;
  }
  .blog-lista li {
    display: flex;
    flex-direction: column;
  }

  .cierre {
    padding-block: clamp(48px, 5vw, 96px);
    text-align: center;
  }
  .cierre p {
    margin: 12px 0 clamp(20px, 1.6vw, 30px);
    font-size: 17px;
    line-height: 1.6;
    color: var(--texto);
  }

  @media (max-width: 1100px) {
    .blog-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .blog-lista {
      grid-template-columns: 1fr;
    }
  }
</style>
