---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ComoUtilizarlas from '../components/ComoUtilizarlas.astro';
import BlogCard from '../components/BlogCard.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/home/Hero.astro';
import BenefitsBar from '../components/home/BenefitsBar.astro';
import About from '../components/home/About.astro';
import FeatureSlider from '../components/home/FeatureSlider.astro';
import ProductGrid from '../components/home/ProductGrid.astro';
import Testimonials from '../components/home/Testimonials.astro';
import TiendaSwipe from '../components/tienda/TiendaSwipe.astro';
import { getPosts } from '../data/blog';
import { getProductos, tiendaActiva } from '../data/tienda';
import { getCollection } from 'astro:content';

// En modo tienda (Hostinger) el inicio es solo la tienda con tarjetas deslizables,
// a pantalla completa y sin header ni footer;
// en GitHub Pages sigue siendo el inicio informativo del Figma.
const productos = await getProductos();
const posts = tiendaActiva ? [] : (await getPosts()).slice(0, 4);
// Opiniones de clientes (WordPress: CPT UI «testimonios» + ACF): van mezcladas en el mazo.
const testimonios = tiendaActiva ? await getCollection('testimonios') : [];
// Banners (WordPress: CPT UI «banners» + ACF): tarjetas de promoción dentro del mazo.
const banners = tiendaActiva ? await getCollection('banners') : [];

const sitio = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': tiendaActiva ? 'OnlineStore' : 'Organization',
      name: 'CK Oído',
      url: sitio,
      logo: new URL('img/logo-ck.svg', sitio).href,
      description: 'Gotas de uso tópico que secan el agua atrapada en el oído y ayudan a prevenir infecciones del oído externo.',
      parentOrganization: { '@type': 'Organization', name: 'Roleisa Farmacéutica' },
    },
    { '@type': 'WebSite', name: 'CK Oído', url: sitio, inLanguage: 'es-CR' },
  ],
};
---
<Base
  title={tiendaActiva ? 'Tienda CK Oído | Gotas para los oídos' : 'CK Oído | Gotas para prevenir infecciones en los oídos'}
  description="CK Oído: gotas de uso tópico que secan el agua atrapada en el oído después de nadar o bañarse y ayudan a prevenir infecciones del oído externo."
  jsonLd={jsonLd}
>
  {tiendaActiva ? (
    <TiendaSwipe productos={productos} testimonios={testimonios} banners={banners} />
  ) : (
  <>
  <Header />
  <main>
    <Hero />
    <BenefitsBar />
    <About />
    <FeatureSlider />
    <ProductGrid />
    <ComoUtilizarlas />
    <Testimonials />

    <section class="blog container" aria-labelledby="blog-titulo">
      <h2 id="blog-titulo">Nuestro Blog</h2>
      <ul class="blog-lista">
        {posts.map((post) => (
          <li><BlogCard post={post} /></li>
        ))}
      </ul>
    </section>

    <ContactSection />
  </main>
  <Footer />
  </>
  )}
</Base>

<style>
  /* Título a 147px de la banda gris; 4 tarjetas de 400px (Figma 1920) */
  .blog {
    padding-top: clamp(56px, 7.65vw, 147px);
    padding-bottom: clamp(16px, 3.3vw, 64px);
  }

  .blog h2 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(28px, 2.08vw, 40px);
    line-height: 1.21;
    color: var(--azul-900);
  }

  .blog-lista {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 1.18vw, 22.6px);
    margin: clamp(28px, 3.2vw, 61px) 0 0;
    padding: 0;
    list-style: none;
  }
  .blog-lista li {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1100px) {
    .blog-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .blog-lista {
      grid-template-columns: 1fr;
    }
  }
</style>
