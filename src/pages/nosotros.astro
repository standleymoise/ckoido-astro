---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageTitle from '../components/PageTitle.astro';
import SplitSection from '../components/SplitSection.astro';
import PromoBanner from '../components/PromoBanner.astro';
import ComoFunciona from '../components/home/ComoFunciona.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import { comprarHref, marca } from '../data/sitio';
import foto from '../assets/blog/piscina.png';
---
<Base
  title={`Nosotros | ${marca.nombre}`}
  description={`${marca.nombre} es una tienda en línea de Costa Rica en la que se compra deslizando tarjetas: rápido, simple y desde el celular.`}
>
  <Header />
  <main>
    <PageTitle title="Nosotros" />

    <SplitSection
      id="acerca"
      image={foto}
      alt="Mujer sonriente descansando en el borde de una piscina"
      title={`Acerca de ${marca.nombre}`}
      ratio="748 / 470"
      priority
    >
      <p>
        {marca.nombre} nació de una idea simple: comprar en línea debería ser tan fácil como pasar fotos en el
        celular. En lugar de filtros, menús y páginas eternas, le mostramos un producto a la vez en una tarjeta.
      </p>
      <p>
        Usted decide con un gesto: lo que le gusta va al carrito, lo que no, se queda atrás, y lo que quiere pensar
        con calma lo guarda en favoritos. Así encuentra lo que busca en pocos minutos.
      </p>
      <a class="btn" href={comprarHref}>Empezar a deslizar</a>
    </SplitSection>

    <ComoFunciona title="Comprar con un gesto" />

    <PromoBanner />
    <Newsletter />
  </main>
  <Footer />
</Base>

<style>
  /* Foto vertical recortada a lo ancho: mantener la cara visible. */
  :global(#acerca .foto img) {
    object-position: 50% 58%;
  }
</style>
