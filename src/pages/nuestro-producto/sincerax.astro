---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageTitle from '../../components/PageTitle.astro';
import SplitSection from '../../components/SplitSection.astro';
import Newsletter from '../../components/Newsletter.astro';
import Footer from '../../components/Footer.astro';
import { url } from '../../data/sitio';
import BotonComprar from '../../components/BotonComprar.astro';
import fotoCaja from '../../assets/producto/sincerax-caja.jpg';
import fotoFamilia from '../../assets/producto/sincerax-familia.jpg';
import fotoFrascos from '../../assets/producto/sincerax-frascos.jpg';

const beneficios = [
  'Efectividad comprobada para disolver incluso los tapones más difíciles.',
  'Reduce molestias y riesgos de infecciones auditivas.',
  'Apto para adultos y niños mayores de 6 años.',
  'Ideal para quienes usan audífonos o trabajan en ambientes polvorientos.',
  'Favorece la higiene.',
  'Evita la formación de tapones de cera.',
  'Su presentación favorece la autolimpieza sin riesgos.',
];
---
<Base
  title="Sincerax | CK Oído"
  description="Sincerax: solución para disolver de forma segura y efectiva el exceso de cera en los oídos, apta para toda la familia."
>
  <Header />
  <main>
    <PageTitle title="Nuestro producto" />

    <SplitSection
      image={fotoCaja}
      alt="Caja y frasco de Sincerax, removedor de cerumen, sobre agua con el mar de fondo"
      title="Sincerax"
      ratio="748 / 470"
      priority
    >
      <p>
        Sincerax, solución original avanzada y diseñada para disolver de manera segura y efectiva el exceso de cera en
        los oídos. Su fórmula suave es apta para toda la familia y promueve una higiene auditiva óptima.
      </p>
      <h3 class="ingredientes">Ingredientes y seguridad</h3>
      <p>
        La fórmula de Sincerax está elaborada con ingredientes seguros y efectivos como peróxido de hidrógeno, ácido
        fosfórico, benzoato de sodio y agua, garantizando una limpieza suave y sin irritaciones, al mismo tiempo que
        puede lavarse con seguridad los restos que pudieran quedar.
      </p>
      <BotonComprar sku="sincerax" />
    </SplitSection>

    <section class="beneficios" aria-labelledby="beneficios-titulo">
      <img class="ondas" src={url("/img/producto/ondas-beneficios.svg")} alt="" aria-hidden="true" loading="lazy" />
      <div class="container grid">
        <div class="texto">
          <h2 id="beneficios-titulo">Beneficios principales</h2>
          <ul>
            {beneficios.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div class="fotos">
          <Image
            src={fotoFamilia}
            alt="Familia sonriente: madre y padre cargando a su bebé"
            widths={[300, 390, 600, 780]}
            sizes="(max-width: 900px) 46vw, 20vw"
            format="webp"
            quality={78}
            loading="lazy"
          />
          <Image
            src={fotoFrascos}
            alt="Frascos de AQUA y Sincerax removedor de cerumen, 30 ml"
            widths={[300, 390, 600, 780]}
            sizes="(max-width: 900px) 46vw, 20vw"
            format="webp"
            quality={78}
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <Newsletter />
  </main>
  <Footer />
</Base>

<style>
  :global(.cuerpo) h3.ingredientes {
    margin-bottom: 8px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.602;
    color: #1e799d;
  }

  .beneficios {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(48px, 3.6vw, 70px) clamp(48px, 3vw, 57px);
    color: #fff;
    background: linear-gradient(225deg, #0a4584 10%, #0d64c1 100%);
  }
  .ondas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 793fr) minmax(0, 815fr);
    gap: clamp(32px, 3vw, 56px);
    align-items: center;
  }
  h2 {
    margin: 0 0 clamp(24px, 1.95vw, 37px);
    font-weight: 700;
    font-size: clamp(28px, 2.08vw, 40px);
    line-height: 1.2;
    color: #fff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(18px, 1.9vw, 37px);
  }
  li {
    position: relative;
    padding-left: 1.2em;
    font-size: 17px;
    line-height: 1.3;
  }
  li::before {
    content: '–';
    position: absolute;
    left: 0;
  }

  .fotos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 35px);
  }
  .fotos :global(img) {
    width: 100%;
    aspect-ratio: 390 / 542;
    object-fit: cover;
    border-radius: 20px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    li {
      font-size: 16px;
    }
  }
  @media (max-width: 480px) {
    .fotos {
      gap: 12px;
    }
  }
</style>
