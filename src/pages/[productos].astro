---
// Página /productos: catálogo leído de WooCommerce al compilar.
// (No se llama /tienda porque en Hostinger esa carpeta es la del subdominio tienda., WordPress.)
// Solo se genera cuando PUBLIC_TIENDA_URL está definida (ver src/data/tienda.ts);
// en GitHub Pages no existe.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageTitle from '../components/PageTitle.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import Precio from '../components/Precio.astro';
import { getProductos, tiendaActiva } from '../data/tienda';
import { rutas, comprarProducto, marca } from '../data/sitio';

export function getStaticPaths() {
  return tiendaActiva ? [{ params: { productos: 'productos' } }] : [];
}

const productos = await getProductos();

// Cada tarjeta abre la tienda con ese producto primero.
const enlace = (sku: string, fichaUrl: string) => (sku ? comprarProducto(sku) : fichaUrl);
---
<Base
  title={`Productos | ${marca.nombre}`}
  description={`Todos los productos de ${marca.nombre}: precios y disponibilidad. Ábralos en la tienda y compre deslizando.`}
>
  <Header />
  <main>
    <PageTitle title="Productos" />

    <section class="tienda container" aria-label="Productos">
      {productos.length === 0 ? (
        <p class="vacio">
          Pronto tendremos productos en línea. Mientras tanto, <a href={rutas.contacto}>escríbanos</a> si busca algo en especial.
        </p>
      ) : (
        <ul class="lista">
          {productos.map((p) => (
            <li class="tarjeta">
              <a class="foto" href={enlace(p.sku, p.fichaUrl)}>
                {p.imagen && (
                  <Image
                    src={p.imagen.src}
                    alt={p.imagen.alt}
                    inferSize
                    format="webp"
                    widths={[240, 400, 600]}
                    sizes="(max-width: 640px) 80vw, (max-width: 960px) 40vw, 25vw"
                  />
                )}
              </a>
              <div class="info">
                <h2><a href={enlace(p.sku, p.fichaUrl)}>{p.nombre}</a></h2>
                {p.resumen && <p class="resumen">{p.resumen}</p>}
                <p class="precio"><Precio {...p} /></p>
                {p.enStock ? (
                  <a class="btn" href={comprarProducto(p.sku)}>Comprar</a>
                ) : (
                  <span class="agotado">Agotado por ahora</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <Newsletter />
  </main>
  <Footer />
</Base>

<style>
  .tienda {
    padding-block: clamp(48px, 5vw, 96px);
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(20px, 2vw, 40px);
  }
  .tarjeta {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--borde);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }
  .foto {
    display: block;
    aspect-ratio: 1;
    padding: 20px;
    overflow: hidden;
    background: linear-gradient(0deg, var(--celeste), var(--blanco-76));
  }
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }
  h2 {
    margin: 0;
    font-size: clamp(19px, 1.2vw, 22px);
    line-height: 1.3;
  }
  h2 a {
    color: var(--azul-900);
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  .resumen {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto);
  }
  .precio {
    margin: auto 0 0;
    font-family: var(--font-alt);
    font-weight: 700;
    font-size: 24px;
    color: var(--azul-900);
  }
  .btn {
    align-self: flex-start;
    padding: 14px 32px;
  }
  .agotado {
    font-weight: 600;
    color: var(--rojo);
  }
  .vacio,
  .nota {
    margin: 32px 0 0;
    color: var(--texto);
  }
  .vacio {
    margin: 0;
  }
</style>
