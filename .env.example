# Copiar como .env y completar con los IDs de Formspree (https://formspree.io/f/<ID>).
# Usar un formulario distinto para cada uno: el de contacto exige nombre y mensaje.
PUBLIC_FORMSPREE_CONTACTO=
PUBLIC_FORMSPREE_BOLETIN=

# Modo tienda: URL del WordPress + WooCommerce (sin barra final).
# Con esta variable, Astro lee productos y precios de la Store API al compilar,
# crea /tienda y los botones «Comprar ahora» agregan al carrito de WooCommerce.
# Vacía = sitio informativo (GitHub Pages).
PUBLIC_TIENDA_URL=
